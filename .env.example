# Root environment template (used by docker compose)
# Copy to `.env` and fill values as needed.
# Do not keep placeholder values in any hosted environment.

# Mongo / Redis
MONGO_PASSWORD=replace_with_a_strong_mongo_password
REDIS_PASSWORD=replace_with_a_strong_redis_password

# Auth / crypto
JWT_SECRET=replace_with_a_long_random_jwt_secret
REFRESH_TOKEN_SECRET=replace_with_a_long_random_refresh_secret
ENCRYPTION_KEY=replace_with_32_character_secret_key

# App
NODE_ENV=production

# CORS (comma-separated origins)
# Examples:
# CORS_ORIGIN=http://localhost,http://127.0.0.1
# CORS_ORIGIN=https://chengeto.health,https://www.chengeto.health
CORS_ORIGIN=

# MQTT
MQTT_PORT=1883
MQTT_WS_PORT=8083
# Demo auth accepts any non-empty username/password (simulators).
MQTT_DEMO_AUTH=false

# Frontend runtime URLs (Vite)
VITE_API_URL=
VITE_SOCKET_URL=

# Optional integrations (leave blank for demo)
CONTRACT_ADDRESS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMTP_USER=
SMTP_PASS=

# Monitoring / alert routing
ALERTMANAGER_DEFAULT_WEBHOOK_URL=
