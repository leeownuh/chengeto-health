# Frontend (Vite) environment template
# Copy to `.env` for local dev or set these as build-time env vars in your hosting provider.
# Leave public marketing values blank until you know what should be displayed.

# Backend API base URL (must include `/api/v1`).
VITE_API_URL=http://localhost:5000/api/v1

# Backend Socket.IO base URL (no path).
VITE_SOCKET_URL=http://localhost:5000

# Optional: override backend port for local runtime URL helpers.
VITE_BACKEND_PORT=5000

# Public marketing site contact details
VITE_PUBLIC_CONTACT_EMAIL=contact@chengeto.health
VITE_PUBLIC_CONTACT_PHONE=
VITE_PUBLIC_CONTACT_WHATSAPP=
VITE_PUBLIC_CAREERS_EMAIL=careers@chengeto.health

# Optional: show ZWL estimates alongside USD pricing (ZWL per 1 USD).
# Leave blank to hide ZWL estimates.
VITE_PUBLIC_ZWL_PER_USD=
